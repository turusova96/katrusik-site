# ─── Cloudflare ────────────────────────────────────────────────────────────
# Скопируй в .env рядом, подставь значения, chmod 600.
#
#  Account ID — Cloudflare, справа в сайдбаре страницы аккаунта, либо
#               прямо в URL: dash.cloudflare.com/<ACCOUNT_ID>/...
#               32 hex-символа.
CLOUDFLARE_ACCOUNT_ID=

#  API Token  — My Profile -> API Tokens -> Create Token -> Custom token.
#               НЕ «Global API Key»: тот даёт полный доступ к аккаунту.
#               Права нужны ровно эти три:
#                 Account -> Cloudflare Pages -> Edit
#                 Zone    -> DNS              -> Edit
#                 Zone    -> Zone             -> Read
#               Zone Resources: Include -> Specific zone -> katrusik.pro
#               Кладётся сама строка, без слова Bearer.
CLOUDFLARE_API_TOKEN=

#  Zone ID    — Overview домена katrusik.pro, блок «API» справа.
#               Можно оставить пустым: достану по токену.
CLOUDFLARE_ZONE_ID=

# ─── Форма «побщаться со мной» ─────────────────────────────────────────────
# Уйдут в секреты Pages, в файлах сайта их не будет.
# Действующие значения лежат на VPS в
#   /var/www/html/wordpress/katrusik.pro/send_to_telegram.php
# Токен оттуда годами лежал открытым, поэтому лучше выпустить новый
# у @BotFather и вписать сюда уже его. Chat ID можно взять прежний.
TG_TOKEN=
TG_CHAT_ID=

# ─── Turnstile (бесплатная капча CF) ───────────────────────────────────────
# Появятся после создания виджета в Cloudflare -> Turnstile.
# Сейчас у формы нет никакой защиты от спама.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
